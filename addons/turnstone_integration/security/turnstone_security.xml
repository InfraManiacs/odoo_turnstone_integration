<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Odoo 19 reworked group categorisation: res.groups.category_id is gone,
            replaced by privilege_id -> res.groups.privilege, which itself points at
            an ir.module.category. Both records are needed.
        -->
        <record id="module_category_turnstone" model="ir.module.category">
            <field name="name">Turnstone</field>
            <field name="description">Access to Turnstone agents from Odoo.</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_turnstone" model="res.groups.privilege">
            <field name="name">Turnstone</field>
            <field name="description">Who may chat with Turnstone agents, and who may configure the servers.</field>
            <field name="category_id" ref="module_category_turnstone"/>
            <field name="sequence">20</field>
        </record>

        <record id="group_turnstone_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_turnstone"/>
            <field name="comment">
                Can chat with Turnstone agents and see their own sessions. Cannot
                configure servers, cannot read API tokens, and cannot see other
                people's conversations.
            </field>
        </record>

        <record id="group_turnstone_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_turnstone"/>
            <field name="implied_ids" eval="[(4, ref('group_turnstone_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">
                Configures Turnstone servers and holds the API tokens. Can see every
                session, which is a real privilege: a session transcript contains
                whatever the agent read, and the agent reads with the server token's
                authority rather than the chatting user's.
            </field>
        </record>

        <!--
            A session is private to its owner. Managers see everything, because
            they are the people who answer "what did the agent do yesterday".
        -->
        <record id="rule_session_own" model="ir.rule">
            <field name="name">Turnstone: own sessions only</field>
            <field name="model_id" ref="model_turnstone_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_session_manager" model="ir.rule">
            <field name="name">Turnstone: managers see all sessions</field>
            <field name="model_id" ref="model_turnstone_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_manager'))]"/>
        </record>

        <record id="rule_message_own" model="ir.rule">
            <field name="name">Turnstone: own messages only</field>
            <field name="model_id" ref="model_turnstone_message"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_user'))]"/>
        </record>

        <record id="rule_message_manager" model="ir.rule">
            <field name="name">Turnstone: managers see all messages</field>
            <field name="model_id" ref="model_turnstone_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_manager'))]"/>
        </record>

        <record id="rule_subagent_own" model="ir.rule">
            <field name="name">Turnstone: own subagents only</field>
            <field name="model_id" ref="model_turnstone_subagent"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_user'))]"/>
        </record>

        <record id="rule_subagent_manager" model="ir.rule">
            <field name="name">Turnstone: managers see all subagents</field>
            <field name="model_id" ref="model_turnstone_subagent"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_manager'))]"/>
        </record>

        <record id="rule_link_own" model="ir.rule">
            <field name="name">Turnstone: own linked records only</field>
            <field name="model_id" ref="model_turnstone_linked_record"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_user'))]"/>
        </record>

        <record id="rule_link_manager" model="ir.rule">
            <field name="name">Turnstone: managers see all linked records</field>
            <field name="model_id" ref="model_turnstone_linked_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_manager'))]"/>
        </record>

        <!--
            Everyone may READ agent definitions (the picker needs them), but
            _available_for_user filters what is offered and _check_user_allowed
            is what actually gates starting one. Reading a definition is not the
            privilege; running it is.
        -->
        <record id="rule_agent_company" model="ir.rule">
            <field name="name">Turnstone: agents per company</field>
            <field name="model_id" ref="model_turnstone_agent"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!--
            A user sees their own audit trail; managers see everyone's. Nobody
            can write or delete: the model refuses both, and the ACLs grant no
            write bit even to managers.
        -->
        <record id="rule_audit_own" model="ir.rule">
            <field name="name">Turnstone: own audit entries</field>
            <field name="model_id" ref="model_turnstone_audit_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_user'))]"/>
        </record>

        <record id="rule_audit_manager" model="ir.rule">
            <field name="name">Turnstone: managers see the whole audit trail</field>
            <field name="model_id" ref="model_turnstone_audit_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_turnstone_manager'))]"/>
        </record>

        <record id="rule_connection_company" model="ir.rule">
            <field name="name">Turnstone: connections per company</field>
            <field name="model_id" ref="model_turnstone_connection"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!--
            Automations are configuration, and configuration is company
            property: "new helpdesk ticket" in one company is a different rule,
            with a different agent, from the same words in another. The rule is
            global (no `groups`) rather than manager-only on purpose — a
            manager is not exempt from it, because a manager who could see
            another company's rules could read that company's prompt templates
            and point them at its agents. Managers still see every rule of
            every company they are allowed to work in, since `company_ids` is
            the user's whole allowed set, not just the selected company.

            The model is manager-only at the ACL level (`ir.model.access.csv`):
            an ordinary user has no read on a rule at all. That is deliberate —
            a rule names an agent and a prompt, and reading it is reading the
            configured authority of the automation.
        -->
        <record id="rule_automation_company" model="ir.rule">
            <field name="name">Turnstone: automations per company</field>
            <field name="model_id" ref="model_turnstone_automation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!--
            A run inherits its rule's company (`company_id` is a stored related
            field on the model), so this one rule is what makes "automation
            rows are never visible across companies" true for the run history
            too — including for a manager, since the rule is global.

            This is the only rule a run needs, because it is the one the
            requirement is about. Ordinary users hold a read-only ACL on runs,
            so "read runs of automations they are allowed to see and nothing
            else" is exactly: the runs of the automations in their companies,
            with no way to create, change or delete one. Writing a run (a state
            transition, a recorded error) is the launch service's job, and it
            does so under `sudo()` — the model's own `write()` is the choke
            point that keeps the state graph honest, and no user needs the bit.
        -->
        <record id="rule_automation_run_company" model="ir.rule">
            <field name="name">Turnstone: automation runs per company</field>
            <field name="model_id" ref="model_turnstone_automation_run"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>

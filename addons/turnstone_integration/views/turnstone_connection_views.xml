<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_turnstone_connection_list" model="ir.ui.view">
        <field name="name">turnstone.connection.list</field>
        <field name="model">turnstone.connection</field>
        <field name="arch" type="xml">
            <list string="Turnstone Servers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="base_url"/>
                <field name="is_default"/>
                <field name="session_count" string="Sessions"/>
                <field name="skill_count" string="Skills"/>
                <field name="status_ok" string="Reachable" widget="boolean_toggle" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_turnstone_connection_form" model="ir.ui.view">
        <field name="name">turnstone.connection.form</field>
        <field name="model">turnstone.connection</field>
        <field name="arch" type="xml">
            <form string="Turnstone Server">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            class="btn-primary"/>
                    <button name="action_sync_catalog" type="object" string="Sync Catalogue"
                            help="Pull skills and personas from Turnstone so they can be picked
                                  from a list instead of typed."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object" class="oe_stat_button"
                                icon="fa-comments">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Production Turnstone"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="base_url" placeholder="https://turnstone.example.com"/>
                            <field name="api_token" password="True"
                                   groups="turnstone_integration.group_turnstone_manager"/>
                            <field name="is_default"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Defaults for new sessions">
                            <field name="default_skill_id" options="{'no_create': True}"/>
                            <field name="default_persona_id" options="{'no_create': True}"/>
                            <field name="default_model" placeholder="agentic-coder"/>
                            <field name="catalog_sync" string="Catalogue synced"/>
                        </group>
                    </group>
                    <group string="Who can use this server">
                        <field name="allowed_group_ids" widget="many2many_tags" nolabel="1"
                               colspan="2"
                               placeholder="Leave empty to allow any Turnstone User"/>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not status">
                        <field name="status" readonly="1" nolabel="1"/>
                    </div>
                    <notebook>
                        <page string="Skills" name="skills">
                            <field name="skill_ids" readonly="1">
                                <list decoration-muted="not available">
                                    <field name="name"/>
                                    <field name="kind"/>
                                    <field name="activation"/>
                                    <field name="enabled"/>
                                    <field name="available" string="On server"/>
                                    <field name="description" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Personas" name="personas">
                            <field name="persona_ids" readonly="1">
                                <list decoration-muted="not available">
                                    <field name="display_label" string="Name"/>
                                    <field name="name" string="Slug"/>
                                    <field name="applies_to_kinds"/>
                                    <field name="is_default"/>
                                    <field name="available" string="On server"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_turnstone_connection" model="ir.actions.act_window">
        <field name="name">Turnstone Servers</field>
        <field name="res_model">turnstone.connection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect Odoo to a Turnstone server</p>
            <p>
                Turnstone runs the agents; this module is the interface. You need the
                server URL and an API token with permission to create workstreams.
            </p>
        </field>
    </record>

</odoo>

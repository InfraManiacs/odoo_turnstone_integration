<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_turnstone_chat" model="ir.actions.client">
        <field name="name">Agent Chat</field>
        <field name="tag">turnstone_integration.chat</field>
    </record>

    <menuitem id="menu_turnstone_root"
              name="Turnstone"
              web_icon="turnstone_integration,static/description/icon.png"
              sequence="90"
              groups="turnstone_integration.group_turnstone_user"/>

    <menuitem id="menu_turnstone_chat"
              name="Agent Chat"
              parent="menu_turnstone_root"
              action="action_turnstone_chat"
              sequence="10"
              groups="turnstone_integration.group_turnstone_user"/>

    <menuitem id="menu_turnstone_agents"
              name="Agents"
              parent="menu_turnstone_root"
              action="action_turnstone_agent"
              sequence="15"
              groups="turnstone_integration.group_turnstone_manager"/>

    <menuitem id="menu_turnstone_sessions"
              name="Sessions"
              parent="menu_turnstone_root"
              action="action_turnstone_session"
              sequence="20"
              groups="turnstone_integration.group_turnstone_user"/>

    <!--
        Both items are Administrator-only, and they sit at the root rather than
        under Configuration for the reason Agents does: they are worked in, not
        set up once. A rule is configuration — which agent to ask, what to ask,
        whose authority the run borrows — so #5759 gives an ordinary User no access
        to turnstone.automation at all. Runs are history a User may read over the
        API, but reviewing and repairing one is an administrator's job, so the
        screen is reached from the Administrator menu.

        Sequences 25 and 26 fill the empty span between Sessions (20) and Live
        Activity (30); no number here repeats within its parent.
    -->
    <menuitem id="menu_turnstone_automations"
              name="Automations"
              parent="menu_turnstone_root"
              action="action_turnstone_automation"
              sequence="25"
              groups="turnstone_integration.group_turnstone_manager"/>

    <menuitem id="menu_turnstone_automation_runs"
              name="Runs"
              parent="menu_turnstone_root"
              action="action_turnstone_automation_run"
              sequence="26"
              groups="turnstone_integration.group_turnstone_manager"/>

    <menuitem id="menu_turnstone_live"
              name="Live Activity"
              parent="menu_turnstone_root"
              action="action_turnstone_live"
              sequence="30"
              groups="turnstone_integration.group_turnstone_manager"/>

    <menuitem id="menu_turnstone_config"
              name="Configuration"
              parent="menu_turnstone_root"
              sequence="90"
              groups="turnstone_integration.group_turnstone_manager"/>

    <menuitem id="menu_turnstone_audit"
              name="Audit Log"
              parent="menu_turnstone_root"
              action="action_turnstone_audit"
              sequence="40"
              groups="turnstone_integration.group_turnstone_user"/>

    <menuitem id="menu_turnstone_connections"
              name="Servers"
              parent="menu_turnstone_config"
              action="action_turnstone_connection"
              sequence="10"
              groups="turnstone_integration.group_turnstone_manager"/>

    <menuitem id="menu_turnstone_schedules"
              name="Scheduled Jobs"
              parent="menu_turnstone_config"
              action="action_turnstone_schedules"
              sequence="20"
              groups="turnstone_integration.group_turnstone_manager"/>

</odoo>
